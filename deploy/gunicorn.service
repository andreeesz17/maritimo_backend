[Unit]
Description=Gunicorn daemon for Maritimo API
After=network.target postgresql.service

[Service]
User=root
Group=www-data
WorkingDirectory=/opt/maritimo_backend
Environment="PATH=/opt/maritimo_backend/.venv/bin"
EnvironmentFile=/opt/maritimo_backend/.env
ExecStart=/opt/maritimo_backend/.venv/bin/gunicorn \
          --workers 3 \
          --bind unix:/run/gunicorn-maritimo.sock \
          --access-logfile /var/log/gunicorn-maritimo-access.log \
          --error-logfile /var/log/gunicorn-maritimo-error.log \
          config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
